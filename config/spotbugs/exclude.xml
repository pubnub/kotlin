<?xml version="1.0" encoding="UTF-8"?>
<!--
    SpotBugs exclude filter. Only Java bytecode is analysed (Kotlin is covered by detekt).
    Existing issues are tracked in config/spotbugs/baseline-<module>.xml, not here.
    See https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Result models and builders hand out their own collections/arrays by design (mostly Lombok-generated). -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Finalizer attacks on validating constructors; not a threat model for SDK value classes. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>