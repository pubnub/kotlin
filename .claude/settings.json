{
  "permissions": {
    "allow": [
      "Bash(scripts/dev/check.sh:*)",
      "Bash(./scripts/dev/check.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-raw-gradle.sh"
          }
        ]
      }
    ]
  }
}