{
 "cases": [
  {
   "name": "simple",
   "text": "// snippet.a\nval x = 1\n// snippet.end\n",
   "ids": [
    "a"
   ],
   "prefixes": [
    "// ",
    "# ",
    "/* ",
    "<!-- ",
    "<%-- "
   ],
   "expected": [
    "val x = 1"
   ]
  },
  {
   "name": "indented",
   "text": "fun f() {\n    // snippet.a\n    val x = 1\n    if (x > 0) {\n        println(x)\n    }\n    // snippet.end\n}\n",
   "ids": [
    "a"
   ],
   "prefixes": [
    "// ",
    "# ",
    "/* ",
    "<!-- ",
    "<%-- "
   ],
   "expected": [
    "val x = 1",
    "if (x > 0) {",
    "    println(x)",
    "}"
   ]
  },
  {
   "name": "nested start ends the outer",
   "text": "// snippet.a\nval x = 1\n// snippet.b\nval y = 2\n// snippet.end\n",
   "ids": [
    "a"
   ],
   "prefixes": [
    "// ",
    "# ",
    "/* ",
    "<!-- ",
    "<%-- "
   ],
   "expected": [
    "val x = 1"
   ]
  },
  {
   "name": "nested start, inner id",
   "text": "// snippet.a\nval x = 1\n// snippet.b\nval y = 2\n// snippet.end\n",
   "ids": [
    "b"
   ],
   "prefixes": [
    "// ",
    "# ",
    "/* ",
    "<!-- ",
    "<%-- "
   ],
   "expected": [
    "val y = 2"
   ]
  },
  {
   "name": "missing space is no marker with default prefixes",
