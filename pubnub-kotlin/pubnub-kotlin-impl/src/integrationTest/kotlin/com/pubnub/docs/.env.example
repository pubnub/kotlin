# Copy to .env.local next to this file (git-ignored) and fill in. Never commit .env.local.
# Real environment variables win over this file. LIVE_ENV_FILE=<path> reads another file instead.

# open: no Access Manager. Message Persistence with Delete-From-History, Presence with a rule on *, App Context with
# events, Files, Stream Controller with wildcard subscribe. Mobile Push credentials are not needed.
PUBLISH_KEY=
SUBSCRIBE_KEY=

# pam: Access Manager with token revocation, plus the same Persistence, Presence, App Context, Files and Stream Controller.
PAM_PUBLISH_KEY=
PAM_SUBSCRIBE_KEY=
PAM_SECRET_KEY=

# datasync: DataSync, Access Manager with token revocation, Persistence, Presence, Stream Controller.
DS_PUBLISH_KEY=
DS_SUBSCRIBE_KEY=
DS_SECRET_KEY=

# Optional, read only: the preflight reads the keyset features through the Admin API.
PUBNUB_ADMIN_API_KEY=
DOCS_SNIPPETS_OPEN_KEYSET_ID=
DOCS_SNIPPETS_PAM_KEYSET_ID=
DOCS_SNIPPETS_DS_KEYSET_ID=

# Optional switches: off skips the cleanup or the feature check (single page runs).
# LIVE_JANITOR=off
# LIVE_PREFLIGHT=off
# LIVE_GROUP=messaging
